{
  // Configurazione per Cloudflare Workers (sito statico + API Stripe).
  "name": "pioxigarden-sito",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  // non cancellare le variabili impostate dalla dashboard di Cloudflare a ogni pubblicazione
  "keep_vars": true,
  // archivio del pannello /admin (foto, testi, prezzi): Cloudflare lo crea da solo alla prima pubblicazione
  "kv_namespaces": [{ "binding": "PX" }],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // il Worker passa per primo: API Stripe e redirect dei domini secondari
    "run_worker_first": true
  }
}
